        <mxCell id="b1" value="Feature&#xa;Transform" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="lane3"><mxGeometry x="610" y="30" width="90" height="40" as="geometry"/></mxCell>
