        <mxCell id="sys" value="Encrypted Malicious Traffic Detection System" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;verticalAlign=top;spacingTop=10;arcSize=10;" vertex="1" parent="1">
