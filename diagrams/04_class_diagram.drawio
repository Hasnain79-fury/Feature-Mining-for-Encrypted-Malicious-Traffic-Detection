<mxfile host="app.diagrams.net">
  <diagram name="Class-Diagram" id="cls1">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="c1" value="&lt;b&gt;FeatureTransformer&lt;/b&gt;&#xa;─────────────────&#xa;- scaler_lstm: StandardScaler&#xa;- scaler_resnet: MinMaxScaler&#xa;- selector_resnet: SelectKBest&#xa;- xgb_medians: ndarray(97,)&#xa;─────────────────&#xa;+ transform(session_data) → tuple&#xa;+ _extract_packet_features() → ndarray&#xa;+ _compute_session_stats() → dict&#xa;+ _build_lstm_input() → (1,15,85)&#xa;+ _build_resnet_input() → (1,1,38,38)&#xa;+ _build_xgb_input() → (1,97)" style="shape=rect;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="30" width="260" height="230" as="geometry"/></mxCell>
        <mxCell id="c2" value="&lt;b&gt;EnsemblePredictor&lt;/b&gt;&#xa;─────────────────&#xa;- lstm: keras.Model&#xa;- resnet: torch.nn.Module&#xa;- xgb: XGBClassifier&#xa;- rf: RandomForestClassifier&#xa;- transformer: FeatureTransformer&#xa;- threshold: float = 0.5&#xa;─────────────────&#xa;+ predict(session_data) → dict&#xa;+ _load_resnet(path) → Module&#xa;+ _resnet_predict(X) → ndarray" style="shape=rect;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="340" y="30" width="250" height="210" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;FastAPIApp&lt;/b&gt;&#xa;────────────&#xa;- predictor: EnsemblePredictor&#xa;────────────&#xa;+ startup(): load_models()&#xa;+ POST /predict(SessionPayload)&#xa;+ GET /health() → dict" style="shape=rect;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="640" y="30" width="230" height="130" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;SessionManager&lt;/b&gt; [JS]&#xa;────────────&#xa;- sessions: Map&#xa;- IDLE_TIMEOUT: 30000&#xa;- MIN_PACKETS: 15&#xa;────────────&#xa;+ addPacket(tabId, domain, data)&#xa;+ flush(sessionKey)&#xa;+ _checkIdle()&#xa;+ _shouldFlush() → bool" style="shape=rect;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="640" y="200" width="220" height="180" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;PacketData&lt;/b&gt; [Pydantic]&#xa;────────────&#xa;+ timestamp: float&#xa;+ duration: float&#xa;+ requestSize: int&#xa;+ responseSize: int&#xa;+ transferSize: int&#xa;+ encodedBodySize: int&#xa;+ protocol: str&#xa;+ statusCode: int" style="shape=rect;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="200" height="180" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b&gt;SessionPayload&lt;/b&gt; [Pydantic]&#xa;────────────&#xa;+ session_id: str&#xa;+ domain: str&#xa;+ packet_count: int&#xa;+ packets: List[PacketData]" style="shape=rect;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="270" y="300" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b&gt;PredictionResponse&lt;/b&gt; [Pydantic]&#xa;────────────&#xa;+ verdict: str&#xa;+ confidence: float&#xa;+ malicious_prob: float&#xa;+ branches: dict&#xa;+ inference_ms: int" style="shape=rect;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="270" y="440" width="220" height="120" as="geometry"/></mxCell>
