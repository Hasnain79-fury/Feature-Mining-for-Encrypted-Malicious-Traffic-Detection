  <diagram name="Swimlane-BackendInference" id="sw2">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="lane1" value="API Router" style="shape=swimlane;horizontal=0;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1100" height="80" as="geometry"/></mxCell>
        <mxCell id="lane2" value="Feature Transformer" style="shape=swimlane;horizontal=0;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="1100" height="100" as="geometry"/></mxCell>
        <mxCell id="lane3" value="LSTM" style="shape=swimlane;horizontal=0;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="1100" height="80" as="geometry"/></mxCell>
        <mxCell id="lane4" value="ResNet" style="shape=swimlane;horizontal=0;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="280" width="1100" height="80" as="geometry"/></mxCell>
        <mxCell id="lane5" value="XGBoost" style="shape=swimlane;horizontal=0;startSize=30;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="360" width="1100" height="80" as="geometry"/></mxCell>
        <mxCell id="lane6" value="RF Ensemble" style="shape=swimlane;horizontal=0;startSize=30;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="440" width="1100" height="80" as="geometry"/></mxCell>
        <!-- Actions -->
        <mxCell id="r1" value="POST /predict&#xa;received" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;" vertex="1" parent="lane1"><mxGeometry x="50" y="15" width="100" height="40" as="geometry"/></mxCell>
        <mxCell id="r2" value="Validate ≥3 pkts" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;" vertex="1" parent="lane1"><mxGeometry x="180" y="20" width="100" height="30" as="geometry"/></mxCell>
        <mxCell id="r3" value="Return 200&#xa;verdict JSON" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;" vertex="1" parent="lane1"><mxGeometry x="930" y="15" width="100" height="40" as="geometry"/></mxCell>
        <mxCell id="t1" value="Extract Group A&#xa;(7 pkt features)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;" vertex="1" parent="lane2"><mxGeometry x="310" y="15" width="110" height="40" as="geometry"/></mxCell>
        <mxCell id="t2" value="Compute Group B&#xa;(78 session stats)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;" vertex="1" parent="lane2"><mxGeometry x="440" y="15" width="120" height="40" as="geometry"/></mxCell>
        <mxCell id="t3" value="Build (15,85)&#xa;+scale" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;" vertex="1" parent="lane2"><mxGeometry x="580" y="15" width="80" height="40" as="geometry"/></mxCell>
        <mxCell id="t4" value="Payload→sel.&#xa;→outer prod" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;" vertex="1" parent="lane2"><mxGeometry x="680" y="15" width="90" height="40" as="geometry"/></mxCell>
        <mxCell id="t5" value="97 feats&#xa;+impute" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;" vertex="1" parent="lane2"><mxGeometry x="790" y="15" width="80" height="40" as="geometry"/></mxCell>
        <mxCell id="l1" value="predict(X_lstm)&#xa;→ p_lstm(2,)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;" vertex="1" parent="lane3"><mxGeometry x="580" y="15" width="100" height="40" as="geometry"/></mxCell>
        <mxCell id="n1" value="predict(X_resnet)&#xa;→ p_resnet(2,)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;" vertex="1" parent="lane4"><mxGeometry x="680" y="15" width="110" height="40" as="geometry"/></mxCell>
        <mxCell id="x1" value="predict_proba(X_xgb)&#xa;→ p_xgb(2,)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;" vertex="1" parent="lane5"><mxGeometry x="790" y="15" width="120" height="40" as="geometry"/></mxCell>
        <mxCell id="rf1" value="hstack(1,6)&#xa;→ predict_proba&#xa;→ verdict" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;" vertex="1" parent="lane6"><mxGeometry x="830" y="10" width="110" height="50" as="geometry"/></mxCell>
      </root>
