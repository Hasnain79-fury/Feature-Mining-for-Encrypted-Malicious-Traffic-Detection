        <mxCell id="e4" value="≥15 pkts:&#xa;build payload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="lane2"><mxGeometry x="480" y="30" width="100" height="40" as="geometry"/></mxCell>
